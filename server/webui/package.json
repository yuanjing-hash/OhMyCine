{
  "name": "@ohmycine/server-webui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "permissions:generate": "node scripts/generate-permissions.mjs",
    "permissions:check": "node scripts/generate-permissions.mjs --check",
    "test": "vitest run",
    "typecheck": "npm run permissions:check && vue-tsc --noEmit",
    "lint": "eslint .",
    "build": "npm run permissions:check && vue-tsc --noEmit && vite build"
  },
  "dependencies": {
    "@unocss/reset": "^66.3.3",
    "pinia": "^3.0.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.0.10",
    "@types/qrcode": "^1.5.6",
    "@unocss/preset-wind3": "^66.3.3",
    "@unocss/vite": "^66.3.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.30.1",
    "eslint-plugin-vue": "^10.3.0",
    "happy-dom": "^20.11.8",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "unocss": "^66.3.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.1"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
