# ====================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ====================
# IDE / Editor
# ====================

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ====================
# Node / JavaScript
# ====================

node_modules/
dist/
.pnpm-store/
.nuxt/
.output/
*.local
.env
.env.*
!.env.example

# Vite
*.local

# TypeScript
*.tsbuildinfo

# Python
__pycache__/
*.pyc

# ====================
# Rust / Tauri (src-tauri)
# ====================

target/
**/*.rs.bk

# Tauri
src-tauri/target/
src-tauri/lib/libmpv.dll.a
src-tauri/lib/mpv.lib

# Native binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# ====================
# Build Outputs
# ====================

# Tauri build
src-tauri/target/

# ====================
# Runtime / Data
# ====================

*.db
*.db-shm
*.db-wal
*.sqlite
*.log
logs/
.tmp/

# ====================
