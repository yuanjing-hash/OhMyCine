#version 450

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D source_frame;
layout(binding = 1, rgba16f) writeonly uniform image2D proxy_output;
layout(push_constant) uniform Parameters {
    ivec2 proxy_size;
    float reference_white_nits;
    float source_peak_nits;
} params;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, params.proxy_size)))
        return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(params.proxy_size);
    vec3 linear_hdr = max(texture(source_frame, uv).rgb, vec3(0.0));
    float peak_scale = max(params.source_peak_nits / max(params.reference_white_nits, 1.0), 1.0);
    vec3 compressed = log2(vec3(1.0) + min(linear_hdr, vec3(peak_scale))) /
                      log2(1.0 + peak_scale);
    imageStore(proxy_output, pixel, vec4(clamp(compressed, 0.0, 1.0), 1.0));
}
