{
  "name": "@ohmycine/player",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "verify:scraper": "TMPDIR=/tmp tsx scripts/verify-scraper-title-classification.ts",
    "verify:alist-auth-recovery": "TMPDIR=/tmp tsx scripts/verify-alist-auth-recovery.ts",
    "verify:home-fault-isolation": "TMPDIR=/tmp tsx scripts/verify-home-source-fault-isolation.ts",
    "verify:home-aggregate-search": "TMPDIR=/tmp tsx scripts/verify-home-aggregate-search.ts",
    "verify:raw-source-index-scheduler": "TMPDIR=/tmp tsx scripts/verify-raw-source-index-scheduler.ts",
    "verify:raw-scan-cache": "TMPDIR=/tmp tsx scripts/verify-raw-scan-cache-storage.ts",
    "verify:local-file-datasource": "TMPDIR=/tmp tsx scripts/verify-local-file-datasource.ts",
    "verify:clouddrive2-datasource": "TMPDIR=/tmp tsx scripts/verify-clouddrive2-datasource.ts",
    "verify:quark-datasource": "TMPDIR=/tmp tsx scripts/verify-quark-datasource.ts",
    "verify:pan123-datasource": "TMPDIR=/tmp tsx scripts/verify-pan123-datasource.ts",
    "verify:webdav-datasource": "TMPDIR=/tmp tsx scripts/verify-webdav-datasource.ts",
    "verify:playback-source-lifecycle": "TMPDIR=/tmp tsx scripts/verify-playback-source-lifecycle.ts",
    "verify:secure-playback-routing": "TMPDIR=/tmp tsx scripts/verify-secure-playback-routing.ts",
    "verify:playback-preferences-shortcuts": "TMPDIR=/tmp tsx scripts/verify-playback-preferences-shortcuts.ts",
    "verify:window-fullscreen-resize": "TMPDIR=/tmp tsx scripts/verify-window-fullscreen-resize-sync.ts",
    "verify:player-controls-autohide": "TMPDIR=/tmp tsx scripts/verify-player-controls-autohide.ts",
    "verify:mobile-ui": "TMPDIR=/tmp tsx scripts/verify-mobile-ui.ts",
    "verify:android-playback": "TMPDIR=/tmp tsx scripts/verify-android-playback.ts",
    "verify:player-buffer-cache-scroll": "TMPDIR=/tmp tsx scripts/verify-player-buffer-cache-scroll.ts",
    "verify:subtitle-search": "TMPDIR=/tmp tsx scripts/verify-subtitle-search.ts",
    "verify:auto-update": "TMPDIR=/tmp tsx scripts/verify-auto-update.ts",
    "verify:storage-portable": "TMPDIR=/tmp tsx scripts/verify-storage-portable-mode.ts",
    "verify:tauri-csp": "TMPDIR=/tmp tsx scripts/verify-tauri-csp.ts",
    "verify:emby-http-boundary": "TMPDIR=/tmp tsx scripts/verify-emby-http-boundary.ts",
    "verify:emby-playback-progress": "TMPDIR=/tmp tsx scripts/verify-emby-playback-progress.ts",
    "verify:view-architecture": "TMPDIR=/tmp tsx scripts/verify-view-architecture.ts",
    "verify:tmdb-auth": "TMPDIR=/tmp tsx scripts/verify-tmdb-auth-routing.ts",
    "verify:theme-controls": "TMPDIR=/tmp tsx scripts/verify-theme-controls.ts",
    "tauri": "tauri",
    "setup:libmpv": "node scripts/setup-libmpv.mjs",
    "setup:libmpv:android": "node scripts/setup-libmpv-android.mjs",
    "tauri:build:linux": "PKG_CONFIG_PATH=/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/share/pkgconfig tauri build --bundles appimage",
    "tauri:build:windows": "PATH=/home/linuxbrew/.linuxbrew/opt/rustup/bin:/home/linuxbrew/.linuxbrew/bin:$PATH tauri build --target x86_64-pc-windows-gnu --bundles nsis",
    "tauri:build:android:preview": "npm run setup:libmpv:android && rm -f src-tauri/gen/android/app/build/outputs/apk/universal/debug/app-universal-debug.apk && env -u HTTP_PROXY -u HTTPS_PROXY -u NO_PROXY ANDROID_HOME=\"${ANDROID_HOME:-$HOME/Android/Sdk}\" ANDROID_SDK_ROOT=\"${ANDROID_SDK_ROOT:-$HOME/Android/Sdk}\" NDK_HOME=\"${NDK_HOME:-$HOME/Android/Sdk/ndk/27.2.12479018}\" JAVA_HOME=\"${JAVA_HOME:-$HOME/.sdkman/candidates/java/current}\" PATH=\"$HOME/.cargo/bin:/home/linuxbrew/.linuxbrew/bin:$PATH\" RUSTC=\"$(rustup which rustc)\" CARGO_PROFILE_DEV_DEBUG=0 CARGO_PROFILE_DEV_STRIP=debuginfo tauri android build --debug --apk --target aarch64 --ci",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src --ext .ts,.vue",
    "lint:fix": "eslint src --ext .ts,.vue --fix"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "ofetch": "^1.4.0",
    "pinia": "^2.2.0",
    "tauri-plugin-libmpv-api": "^0.3.2",
    "vue": "^3.5.0",
    "vue-i18n": "^10.0.8",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@unocss/reset": "^0.65.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "eslint": "^9.39.5",
    "tsx": "^4.23.9",
    "typescript": "^5.7.0",
    "unocss": "^0.65.0",
    "vite": "^6.4.3",
    "vue-tsc": "^2.2.0"
  }
}
