{
  "name": "@ohmycine/player",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "verify:home-aggregate-search": "tsx scripts/verify-home-aggregate-search.ts",
    "verify:series-episode-search": "tsx scripts/verify-series-episode-search.ts",
    "verify:playback-source-lifecycle": "tsx scripts/verify-playback-source-lifecycle.ts",
    "verify:playback-preferences-shortcuts": "tsx scripts/verify-playback-preferences-shortcuts.ts",
    "verify:window-fullscreen-resize": "tsx scripts/verify-window-fullscreen-resize-sync.ts",
    "verify:mobile-ui": "tsx scripts/verify-mobile-ui.ts",
    "verify:fsr-upscaling": "tsx scripts/verify-fsr-upscaling.ts",
    "verify:tauri-csp": "tsx scripts/verify-tauri-csp.ts",
    "verify:emby-playback-progress": "tsx scripts/verify-emby-playback-progress.ts",
    "verify:emby-favorites": "tsx scripts/verify-emby-favorites.ts",
    "verify:server-datasource": "tsx scripts/verify-server-datasource.ts",
    "verify:server-online-library": "tsx scripts/verify-server-online-library.ts",
    "verify:server-library-navigation": "tsx scripts/verify-server-library-navigation.ts",
    "verify:stream-quality": "tsx scripts/verify-stream-quality-switch.ts",
    "verify:secret-inputs": "tsx scripts/verify-secret-inputs.ts",
    "verify:media-actions": "tsx scripts/verify-media-actions.ts",
    "verify:media-delete": "tsx scripts/verify-media-delete.ts",
    "verify:download-planning": "tsx scripts/verify-download-planning.ts",
    "verify:danmaku": "tsx scripts/verify-danmaku.ts",
    "tauri": "tauri",
    "tauri:dev:windows": "tauri dev --target x86_64-pc-windows-msvc",
    "tauri:dev:windows:gnu": "tauri dev --target x86_64-pc-windows-gnu",
    "setup:libmpv": "node scripts/setup-libmpv.mjs",
    "setup:libmpv:android": "node scripts/setup-libmpv-android.mjs",
    "tauri:build:linux": "PKG_CONFIG_PATH=/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/share/pkgconfig tauri build --bundles appimage",
    "tauri:build:windows": "PATH=/home/linuxbrew/.linuxbrew/opt/rustup/bin:/home/linuxbrew/.linuxbrew/bin:$PATH tauri build --target x86_64-pc-windows-gnu --bundles nsis",
    "tauri:build:windows:native": "tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "tauri:build:android:preview": "node scripts/build-android-preview.mjs",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src --ext .ts,.vue",
    "lint:fix": "eslint src --ext .ts,.vue --fix",
    "verify:local-playlist": "tsx scripts/verify-local-playlist.ts",
    "verify:source-migration": "tsx scripts/verify-source-migration.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "ofetch": "^1.4.0",
    "pinia": "^2.2.0",
    "tauri-plugin-libmpv-api": "^0.3.2",
    "vue": "^3.5.0",
    "vue-i18n": "^10.0.8",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@unocss/reset": "^0.65.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "eslint": "^9.39.5",
    "tsx": "^4.23.9",
    "typescript": "^5.7.0",
    "unocss": "^0.65.0",
    "vite": "^6.4.3",
    "vue-tsc": "^2.2.0"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
